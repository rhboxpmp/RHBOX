# ==============================================================================
# RHBOX — Variáveis de Ambiente do Supabase (Plano Gratuito)
# Configure estas variáveis na Vercel (Settings -> Environment Variables)
# ou em .env.local para rodar localmente conectado ao Supabase.
# ==============================================================================

# URL do projeto (Supabase -> Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (Supabase -> Project Settings -> API -> anon/public ou Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-do-supabase

# Chave de serviço (Supabase -> Project Settings -> API -> service_role / Secret key)
# Necessária para criar novos usuários diretamente pela tela "Admin & Logs"
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-somente-servidor
