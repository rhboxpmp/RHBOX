# ==============================================================================
# RHBOX Simples — Configuração do Supabase (compatível com Plano Gratuito)
# Copie para .env.local quando quiser conectar ao seu projeto Supabase.
# Sem este arquivo, o app roda automaticamente em Modo Local Interativo (.data/).
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-opcional-apenas-servidor
